{
  "name": "calefaccion-acs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply calefaccion-acs --local",
    "db:seed:local": "wrangler d1 execute calefaccion-acs --local --file=./data/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply calefaccion-acs --remote",
    "db:seed:remote": "wrangler d1 execute calefaccion-acs --remote --file=./data/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@vitejs/plugin-react": "latest",
    "pdfjs-dist": "^5.4.624",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
